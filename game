<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game Tap Target</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 16px;
      box-sizing: border-box;
    }

    .card {
      width: 100%;
      max-width: 420px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      border-radius: 20px;
      padding: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      text-align: center;
      color: white;
    }

    h1 {
      margin-top: 0;
      font-size: 28px;
    }

    .desc {
      font-size: 14px;
      margin-bottom: 16px;
      opacity: 0.95;
    }

    .info {
      display: flex;
      justify-content: space-between;
      margin: 16px 0;
      font-size: 18px;
      font-weight: bold;
    }

    button {
      background: #00e676;
      color: #111;
      border: none;
      padding: 12px 20px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin-bottom: 16px;
    }

    button:disabled {
      opacity: 0.6;
    }

    #gameArea {
      position: relative;
      width: 100%;
      height: 360px;
      background: white;
      border-radius: 18px;
      overflow: hidden;
      border: 4px solid #222;
      box-sizing: border-box;
      touch-action: manipulation;
    }

    #target {
      position: absolute;
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #fff, #ffd54f 30%, #ff9800 70%, #f44336);
      display: none;
      box-shadow: 0 8px 18px rgba(0,0,0,0.25);
    }

    #message {
      margin-top: 14px;
      min-height: 24px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Game Tap Target</h1>
    <div class="desc">Tap lingkaran secepat mungkin dalam 30 detik.</div>

    <div class="info">
      <div>Skor: <span id="score">0</span></div>
      <div>Waktu: <span id="time">30</span>s</div>
    </div>

    <button id="startBtn">Mulai Game</button>

    <div id="gameArea">
      <div id="target"></div>
    </div>

    <div id="message">Tekan tombol "Mulai Game"</div>
  </div>

  <script>
    const gameArea = document.getElementById("gameArea");
    const target = document.getElementById("target");
    const scoreEl = document.getElementById("score");
    const timeEl = document.getElementById("time");
    const messageEl = document.getElementById("message");
    const startBtn = document.getElementById("startBtn");

    let score = 0;
    let timeLeft = 30;
    let gameTimer = null;
    let moveTimer = null;
    let isPlaying = false;

    function moveTarget() {
      const targetSize = 70;
      const maxX = gameArea.clientWidth - targetSize;
      const maxY = gameArea.clientHeight - targetSize;

      const x = Math.random() * maxX;
      const y = Math.random() * maxY;

      target.style.left = x + "px";
      target.style.top = y + "px";
    }

    function startGame() {
      score = 0;
      timeLeft = 30;
      isPlaying = true;

      scoreEl.textContent = score;
      timeEl.textContent = timeLeft;
      messageEl.textContent = "Ayo, tap targetnya!";
      target.style.display = "block";
      startBtn.disabled = true;

      moveTarget();

      clearInterval(gameTimer);
      clearInterval(moveTimer);

      gameTimer = setInterval(() => {
        timeLeft--;
        timeEl.textContent = timeLeft;

        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);

      moveTimer = setInterval(moveTarget, 800);
    }

    function endGame() {
      isPlaying = false;
      clearInterval(gameTimer);
      clearInterval(moveTimer);
      target.style.display = "none";
      startBtn.disabled = false;

      let rank = "Coba lagi ya!";
      if (score >= 25) rank = "Hebat banget!";
      else if (score >= 15) rank = "Bagus!";
      else if (score >= 8) rank = "Lumayan!";

      messageEl.textContent = "Waktu habis! Skor kamu: " + score + ". " + rank;
    }

    function hitTarget() {
      if (!isPlaying) return;
      score++;
      scoreEl.textContent = score;
      moveTarget();
    }

    target.addEventListener("click", hitTarget);
    target.addEventListener("touchstart", function(e) {
      e.preventDefault();
      hitTarget();
    }, { passive: false });

    startBtn.addEventListener("click", startGame);
  </script>
</body>
</html>
